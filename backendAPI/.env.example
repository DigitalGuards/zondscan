# Each process serves one network and one MongoDB database.
EXPLORER_NETWORK=v2
MONGO_DB_NAME=qrldata-z
MONGOURI=mongodb://localhost:27017
NODE_URL=http://localhost:8545
HTTP_PORT=8080

# Configure both pins together to verify every configured RPC source.
# EXPECTED_CHAIN_ID=<chain-id>
# EXPECTED_GENESIS_HASH=<0x-prefixed-genesis-hash>
# v3 requires both pins, a separate database, and a reviewed 64-byte build.
# An optional MONGOURI database suffix must match MONGO_DB_NAME.
# Use authSource in the URI when authenticating against another database.
