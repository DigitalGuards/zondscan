# Required backend connections. Supply values for your environment.
MONGOURI=
NODE_URL=

# Optional QNS deployment configuration. Set both values to enable lookups.
# Registry must be a nonzero QIP-55 address; chain ID accepts decimal or hex.
QNS_REGISTRY_ADDRESS=
QNS_EXPECTED_CHAIN_ID=

# Optional server-only QNS caller authentication. Set the same nonempty secret
# on the backend and frontend server. A matching X-QNS-Internal-Token header
# bypasses both QNS per-IP rate limiters without consuming their allowance.
# Empty/unset keeps public limits: reverse 60/minute, forward 30/minute, with
# bursts of 60 and 30 respectively. Never log or expose this value to browsers.
QNS_INTERNAL_TOKEN=
