# ExplorerFrontend environment variables
#
# Copy to `.env` and fill in. Never commit the real `.env` (it is gitignored).

# ── Core explorer ────────────────────────────────────────────────────────────
# Backend REST API URL (used by the frontend and the /api/* rewrite proxy).
NEXT_PUBLIC_HANDLER_URL=http://localhost:8080
HANDLER_URL=http://localhost:8080
# Public domain name of this frontend.
DOMAIN_NAME=http://localhost:3000

# ── Testnet faucet (/faucet) ─────────────────────────────────────────────────
# The faucet signs and broadcasts native testnet transfers server-side. All of
# the secrets below are SERVER-ONLY — never prefix them with NEXT_PUBLIC_.

# Funded QRL 2.0 testnet account the faucet sends from. Accepts either a hex
# extended seed (0x0100...) or a space-separated mnemonic phrase. REQUIRED for
# the faucet to be enabled; when unset, /faucet shows an "offline" state.
FAUCET_SEED=

# MongoDB connection string used to persist per-address/per-IP claim cooldowns
# (collection: faucetClaims, db: qrldata-z). Same Mongo the rest of the stack uses.
DATABASE_URL=mongodb://localhost:27017
# Optional: override the database name (default: qrldata-z).
# MONGO_DB_NAME=qrldata-z

# RPC endpoint the faucet signs/broadcasts against.
# Defaults to the qrlwallet.com testnet proxy when unset.
FAUCET_RPC_URL=https://qrlwallet.com/api/qrl-rpc/testnet

# Drip amount (whole QRL) and cooldown window (hours). Optional; defaults shown.
FAUCET_DRIP_QUANTA=10
FAUCET_COOLDOWN_HOURS=24

# Cloudflare Turnstile (bot protection). When BOTH are set the captcha is
# enforced on every claim; when unset the faucet works without a captcha.
# The site key is public (sent to the browser); the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
