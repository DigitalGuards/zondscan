# ExplorerFrontend environment variables
#
# Copy to `.env` and fill in. Never commit the real `.env` (it is gitignored).

# ── Core explorer ────────────────────────────────────────────────────────────
# Private API origin for server rendering and the /api/* proxy.
HANDLER_URL=http://localhost:8081
# Optional browser API override for a live-data local preview. Default: /api.
# NEXT_PUBLIC_HANDLER_URL=https://zondscan.com/api
# Public domain name of this frontend.
DOMAIN_NAME=http://localhost:3000

# Fixed deployment network. This legacy address build supports v2 only.
# A reviewed 64-byte frontend is required before running a v3 deployment.
EXPLORER_NETWORK=v2
NEXT_PUBLIC_V2_EXPLORER_URL=https://zondscan.com
NEXT_PUBLIC_V3_EXPLORER_URL=
NEXT_PUBLIC_V3_EXPLORER_AVAILABLE=false
# v3 requires its own database and paired identity pins.
# MONGO_DB_NAME=qrldata-z-v3
# EXPECTED_CHAIN_ID=
# EXPECTED_GENESIS_HASH=

# ── Testnet faucet (/faucet) ─────────────────────────────────────────────────
# The faucet signs and broadcasts native testnet transfers server-side. All of
# the secrets below are SERVER-ONLY: never prefix them with NEXT_PUBLIC_.

# Funded QRL 2.0 testnet account the faucet sends from. Accepts either a hex
# extended seed (0x0100...) or a space-separated mnemonic phrase. REQUIRED for
# the faucet to be enabled; when unset, /faucet shows an "offline" state.
FAUCET_SEED=

# MongoDB connection string used to persist per-address/per-IP claim cooldowns
# (collection: faucetClaims, db: qrldata-z). Same Mongo the rest of the stack uses.
DATABASE_URL=mongodb://localhost:27017
# Optional: override the database name (default: qrldata-z).
# MONGO_DB_NAME=qrldata-z

# RPC endpoint the faucet signs/broadcasts against.
# Defaults to the qrlwallet.com testnet proxy when unset.
FAUCET_RPC_URL=https://qrlwallet.com/api/qrl-rpc/testnet

# Drip amount (whole QRL) and cooldown window (hours). Optional; defaults shown.
# Invalid/non-positive values fall back to these defaults.
FAUCET_DRIP_QUANTA=10
FAUCET_COOLDOWN_HOURS=24

# Optional global safety cap: max total QRL dripped across ALL claimers per
# rolling 24h. A backstop against draining when address rotation defeats the
# per-address cooldown. 0 / unset = unlimited.
# FAUCET_DAILY_CAP_QUANTA=0

# Cloudflare Turnstile (bot protection). When BOTH are set the captcha is
# enforced on every claim; when unset the faucet works without a captcha.
# The site key is public (sent to the browser); the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# In production (NODE_ENV=production) the faucet REFUSES to serve claims when no
# captcha is configured, since the cooldown alone is bypassable by address
# rotation. Set this to "true" to explicitly run an uncaptcha'd faucet anyway.
# FAUCET_ALLOW_NO_CAPTCHA=true

# DEPLOYMENT NOTE: the per-IP cooldown trusts CF-Connecting-IP / X-Real-IP /
# X-Forwarded-For. These are forgeable by any client that can reach the origin
# directly, so the origin MUST be firewalled to accept traffic only from your
# Cloudflare (or trusted reverse-proxy) IP ranges. Otherwise the per-IP cooldown
# can be bypassed by spoofing these headers.
